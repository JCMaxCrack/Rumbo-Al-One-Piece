class_name Mat
extends RefCounted
## Realistic materials generated by code (no texture files):
## procedural noise for color and relief (normal map) on stone, wood, plaster, cloth, etc.
## To use real textures, replace these functions.

static var _cache: Dictionary = {}


static func _noise_tex(freq: float, octaves: int, ramp_a: Color, ramp_b: Color, as_normal: bool = false,
		stretch: Vector2 = Vector2.ONE, seed_v: int = 1, bump: float = 6.0, ntype: int = FastNoiseLite.TYPE_SIMPLEX_SMOOTH) -> NoiseTexture2D:
	var n := FastNoiseLite.new()
	n.noise_type = ntype
	n.frequency = freq
	n.fractal_octaves = octaves
	n.seed = seed_v
	var t := NoiseTexture2D.new()
	t.width = int(256 * stretch.x)
	t.height = int(256 * stretch.y)
	t.seamless = true
	t.noise = n
	if as_normal:
		t.as_normal_map = true
		t.bump_strength = bump
	else:
		var g := Gradient.new()
		g.set_color(0, ramp_a)
		g.set_color(1, ramp_b)
		t.color_ramp = g
	return t


## Material with a triplanar procedural texture (no UV coordinates needed).
static func textured(key: String, dark: Color, light: Color, freq: float = 0.02, rough: float = 0.9,
		bump: float = 6.0, scale: float = 0.5, stretch: Vector2 = Vector2.ONE, ntype: int = FastNoiseLite.TYPE_SIMPLEX_SMOOTH) -> StandardMaterial3D:
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_texture = _noise_tex(freq, 5, dark, light, false, stretch, key.hash(), 0.0, ntype)
	m.normal_enabled = true
	m.normal_texture = _noise_tex(freq * 1.6, 4, Color.BLACK, Color.WHITE, true, stretch, key.hash() + 7, bump, ntype)
	m.normal_scale = 0.8
	m.roughness = rough
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_scale = Vector3.ONE * scale
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_cache[key] = m
	return m


static func stone(c: Color = Color(0.45, 0.44, 0.42)) -> StandardMaterial3D:
	return textured("stone" + c.to_html(), c.darkened(0.22), c.lightened(0.04), 0.03, 0.95, 5.0, 0.3, Vector2.ONE, FastNoiseLite.TYPE_CELLULAR)


static func plaster(c: Color = Color(0.9, 0.85, 0.74)) -> StandardMaterial3D:
	return textured("plaster" + c.to_html(), c.darkened(0.12), c.lightened(0.05), 0.05, 0.95, 3.0, 0.4)


static func wood(c: Color = Color(0.45, 0.3, 0.18)) -> StandardMaterial3D:
	return textured("wood" + c.to_html(), c.darkened(0.3), c.lightened(0.1), 0.03, 0.85, 5.0, 0.5, Vector2(0.25, 2.0))


static func bark() -> StandardMaterial3D:
	return textured("bark", Color(0.2, 0.14, 0.09), Color(0.42, 0.31, 0.2), 0.05, 1.0, 12.0, 0.8, Vector2(0.35, 1.6))


static func rock() -> StandardMaterial3D:
	return textured("rock", Color(0.3, 0.29, 0.28), Color(0.62, 0.6, 0.56), 0.03, 0.95, 14.0, 0.25, Vector2.ONE, FastNoiseLite.TYPE_CELLULAR)


static func cloth(c: Color) -> StandardMaterial3D:
	return textured("cloth" + c.to_html(), c.darkened(0.12), c.lightened(0.06), 0.12, 0.95, 2.0, 1.5)


static func skin(c: Color) -> StandardMaterial3D:
	var k := "skin" + c.to_html()
	if _cache.has(k):
		return _cache[k]
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = 0.6
	m.rim_enabled = true
	m.rim = 0.25
	m.rim_tint = 0.6
	_cache[k] = m
	return m


static func metal(c: Color) -> StandardMaterial3D:
	var k := "metal" + c.to_html()
	if _cache.has(k):
		return _cache[k]
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.metallic = 0.85
	m.roughness = 0.3
	_cache[k] = m
	return m


# ------------------------------------------------------------------ shaders
static func roof_tiles(c: Color) -> ShaderMaterial:
	var k := "roof" + c.to_html()
	if _cache.has(k):
		return _cache[k]
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
uniform vec3 base : source_color;
varying vec3 wpos;
varying vec3 wnrm;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz); }
float h(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
void fragment() {
	vec2 p = abs(wnrm.x) > abs(wnrm.z) ? wpos.zy : wpos.xy;
	p.y = wpos.y * 3.2;
	p.x = (abs(wnrm.x) > abs(wnrm.z) ? wpos.z : wpos.x) * 2.4;
	float row = floor(p.y);
	p.x += row * 0.5;
	vec2 cell = fract(p);
	float id = h(vec2(floor(p.x), row));
	float curve = sin(cell.x * 3.14159);
	float edge = smoothstep(0.0, 0.12, cell.y) * (0.75 + 0.25 * curve);
	vec3 col = base * (0.75 + 0.3 * id) * edge;
	ALBEDO = col;
	ROUGHNESS = 0.8;
	NORMAL_MAP = normalize(vec3((cos(cell.x * 3.14159)) * 0.5 + 0.5, 0.5 + (1.0 - edge) * 0.5, 1.0));
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("base", c)
	_cache[k] = m
	return m


static func terrain() -> ShaderMaterial:
	if _cache.has("terrain"):
		return _cache["terrain"]
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
render_mode diffuse_burley;
uniform vec3 grass_a : source_color = vec3(0.15, 0.27, 0.09);
uniform vec3 grass_b : source_color = vec3(0.3, 0.38, 0.16);
uniform vec3 dry : source_color = vec3(0.55, 0.52, 0.28);
uniform vec3 sand : source_color = vec3(0.82, 0.74, 0.54);
uniform vec3 dirt : source_color = vec3(0.45, 0.34, 0.22);
uniform vec3 paving : source_color = vec3(0.4, 0.39, 0.37);
uniform vec3 rock_a : source_color = vec3(0.32, 0.3, 0.28);
uniform vec3 rock_b : source_color = vec3(0.58, 0.55, 0.5);
varying vec3 wpos;
varying vec3 wnrm;
varying vec4 mask;
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}
float fbm(vec2 p) { float v = 0.0; float a = 0.5; for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; } return v; }
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	mask = COLOR;
}
void fragment() {
	vec2 p = wpos.xz;
	float big = fbm(p * 0.02);
	float mid = fbm(p * 0.15);
	float fine = noise(p * 2.5);
	vec3 grass = mix(grass_a, grass_b, big * 0.8 + fine * 0.2);
	grass = mix(grass, dry, smoothstep(0.55, 0.85, fbm(p * 0.05 + 7.0)) * 0.6);
	grass *= 0.85 + 0.3 * mid;
	vec3 col = grass;
	float rough = 0.95;
	// dirt path
	col = mix(col, dirt * (0.8 + 0.4 * mid) * (0.9 + 0.2 * fine), smoothstep(0.3, 0.7, mask.g + (mid - 0.5) * 0.4));
	// sand
	col = mix(col, sand * (0.9 + 0.2 * mid) * (0.95 + 0.1 * fine), smoothstep(0.3, 0.7, mask.r + (mid - 0.5) * 0.3));
	// paving / stone floor
	vec2 tile = fract(p * 1.0);
	float grout = smoothstep(0.0, 0.06, tile.x) * smoothstep(0.0, 0.06, tile.y) * smoothstep(1.0, 0.94, tile.x) * smoothstep(1.0, 0.94, tile.y);
	vec3 pav = paving * (0.75 + 0.35 * hash(floor(p))) * (0.6 + 0.4 * grout);
	col = mix(col, pav, step(0.5, mask.b));
	// rock on slopes and heights
	float slope = 1.0 - wnrm.y;
	vec3 rock = mix(rock_a, rock_b, fbm(vec2(p.x + wpos.y * 0.7, p.y) * 0.25)) * (0.8 + 0.25 * sin(wpos.y * 3.0 + mid * 4.0));
	float rk = smoothstep(0.25, 0.42, slope + (mid - 0.5) * 0.15);
	rk = max(rk, smoothstep(14.0, 22.0, wpos.y + mid * 4.0));
	col = mix(col, rock, rk);
	// snow on peaks
	float snow = smoothstep(30.0, 36.0, wpos.y + mid * 5.0) * smoothstep(0.55, 0.3, slope);
	col = mix(col, vec3(0.92, 0.94, 0.97), snow);
	// wet sand near the water
	col *= mix(0.7, 1.0, smoothstep(-0.3, 0.4, wpos.y));
	ALBEDO = col;
	ROUGHNESS = mix(rough, 0.6, snow);
	NORMAL_MAP = normalize(vec3(0.5 + (noise(p * 3.0) - 0.5) * 0.35, 0.5 + (noise(p * 3.0 + 9.0) - 0.5) * 0.35, 1.0));
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	_cache["terrain"] = m
	return m


static func foliage(c: Color) -> ShaderMaterial:
	var k := "foliage" + c.to_html()
	if _cache.has(k):
		return _cache[k]
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
render_mode cull_disabled, diffuse_burley;
uniform vec3 leaf : source_color;
varying vec3 wpos;
varying float lh;
float hash(vec3 p) { return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453); }
void vertex() {
	lh = VERTEX.y;
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float sway = max(VERTEX.y - 1.0, 0.0) * 0.035;
	VERTEX.x += sin(TIME * 1.6 + w.x * 0.3 + w.z * 0.2) * sway;
	VERTEX.z += cos(TIME * 1.3 + w.z * 0.3) * sway * 0.7;
	wpos = w;
}
void fragment() {
	float n = hash(floor(wpos * 6.0));
	vec3 col = leaf * (0.7 + 0.45 * n);
	col *= mix(0.6, 1.1, clamp((lh - 1.5) * 0.25, 0.0, 1.0));
	ALBEDO = col;
	ROUGHNESS = 0.85;
	SSS_STRENGTH = 0.3;
	BACKLIGHT = vec3(0.25, 0.35, 0.1);
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("leaf", c)
	_cache[k] = m
	return m


static func grass_blades() -> ShaderMaterial:
	if _cache.has("grass"):
		return _cache["grass"]
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
render_mode cull_disabled, diffuse_burley;
uniform vec3 base_col : source_color = vec3(0.1, 0.19, 0.05);
uniform vec3 tip_col : source_color = vec3(0.34, 0.44, 0.16);
varying float hgt;
varying vec3 wpos;
void vertex() {
	hgt = VERTEX.y;
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float wind = sin(TIME * 2.2 + w.x * 0.45 + w.z * 0.3) * 0.5 + sin(TIME * 3.7 + w.x * 1.3) * 0.2;
	VERTEX.x += wind * hgt * hgt * 0.35;
	VERTEX.z += wind * hgt * hgt * 0.15;
	wpos = w;
}
void fragment() {
	float v = fract(sin(dot(floor(wpos.xz * 0.5), vec2(12.9, 78.2))) * 43758.5);
	ALBEDO = mix(base_col, tip_col * (0.85 + 0.3 * v), clamp(hgt * 2.6, 0.0, 1.0));
	ROUGHNESS = 0.9;
	BACKLIGHT = vec3(0.2, 0.3, 0.1);
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	_cache["grass"] = m
	return m


static func water(shore_tex: Texture2D, map_size: Vector2) -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = """
shader_type spatial;
render_mode blend_mix, cull_disabled, depth_draw_opaque, specular_schlick_ggx;
uniform vec3 deep : source_color = vec3(0.02, 0.16, 0.3);
uniform vec3 shallow : source_color = vec3(0.1, 0.55, 0.6);
uniform sampler2D shore : filter_linear;
uniform vec2 map_size = vec2(200.0, 130.0);
varying vec3 wpos;
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}
float waves(vec2 p, float t) {
	return sin(p.x * 0.18 + t * 1.1) * 0.22 + sin(p.y * 0.23 - t * 0.9 + p.x * 0.07) * 0.18 + sin((p.x + p.y) * 0.5 + t * 1.8) * 0.06;
}
void vertex() {
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	VERTEX.y += waves(w.xz, TIME);
	wpos = w;
}
void fragment() {
	vec2 uv = wpos.xz / map_size;
	float sh = 0.0;
	if (uv.x > 0.0 && uv.y > 0.0 && uv.x < 1.0 && uv.y < 1.0) { sh = texture(shore, uv).r; }
	float e = 0.4;
	vec2 p = wpos.xz;
	float t = TIME;
	float hx = waves(p + vec2(e, 0.0), t) - waves(p - vec2(e, 0.0), t);
	float hz = waves(p + vec2(0.0, e), t) - waves(p - vec2(0.0, e), t);
	float ripple = noise(p * 1.5 + t * 0.6) - 0.5;
	vec3 n = normalize(vec3(-hx * 1.5 + ripple * 0.15, 1.0, -hz * 1.5 + ripple * 0.15));
	NORMAL = (VIEW_MATRIX * vec4(n, 0.0)).xyz;
	float fres = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), 3.0);
	vec3 col = mix(deep, shallow, sh);
	float foam = smoothstep(0.75, 0.95, sh + (noise(p * 0.8 + t * 0.4) - 0.5) * 0.35) * (0.6 + 0.4 * sin(t * 2.0 + sh * 12.0));
	col = mix(col, vec3(0.95), foam * 0.8);
	ALBEDO = col + fres * 0.08;
	ALPHA = mix(0.9, 0.6, sh * (1.0 - foam));
	ROUGHNESS = mix(0.04, 0.6, foam);
	METALLIC = 0.0;
	SPECULAR = 0.8;
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("shore", shore_tex)
	m.set_shader_parameter("map_size", map_size)
	return m


static func sky() -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = """
shader_type sky;
uniform vec3 top : source_color = vec3(0.16, 0.38, 0.72);
uniform vec3 horizon : source_color = vec3(0.68, 0.8, 0.9);
uniform vec3 below : source_color = vec3(0.2, 0.3, 0.4);
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}
float fbm(vec2 p) { float v = 0.0; float a = 0.5; for (int i = 0; i < 6; i++) { v += a * noise(p); p *= 2.1; a *= 0.5; } return v; }
void sky() {
	vec3 d = EYEDIR;
	float y = d.y;
	vec3 col = mix(horizon, top, pow(clamp(y, 0.0, 1.0), 0.6));
	if (y < 0.0) { col = mix(horizon, below, clamp(-y * 4.0, 0.0, 1.0)); }
	vec3 sd = LIGHT0_DIRECTION;
	float sun = max(dot(d, sd), 0.0);
	col += vec3(1.0, 0.85, 0.6) * pow(sun, 8.0) * 0.35 + vec3(1.0, 0.95, 0.85) * smoothstep(0.9993, 0.9997, sun) * 4.0;
	if (y > 0.0) {
		vec2 uv = d.xz / (y + 0.15) * 1.2 + vec2(TIME * 0.005, TIME * 0.002);
		float c = fbm(uv * 1.5);
		float cloud = smoothstep(0.5, 0.78, c) * smoothstep(0.0, 0.18, y);
		vec3 cc = mix(vec3(0.75, 0.78, 0.82), vec3(1.0), smoothstep(0.55, 0.9, c));
		col = mix(col, cc, cloud * 0.9);
	}
	COLOR = col;
}
"""
	var m := ShaderMaterial.new()
	m.shader = sh
	return m

class_name IslandLayout
extends RefCounted
## Shape and layout of the islands that are generated by tools/build_islands.gd: the height map
## (2 m between samples, 400 x 400 m), the paths and the places where houses and flat areas go.
## Both stages of the builder (terrain assets and scenes) read the same data from here.

const WORLD := 400.0
const N := 201
const STEP := 2.0
const SEA := 0.0

## The port, the dock and the Going Merry are the same in every island (south coast).
const DOCK_X := 200.0
const DOCK_START_Z := 332.0
const DOCK_END_Z := 357.0
const DOCK_TOP := 1.75
const SHIP_Z := 372.0

var id := ""
var heights := PackedFloat32Array()
var noise := FastNoiseLite.new()
var noise2 := FastNoiseLite.new()
## Polylines of the dirt roads: [[Vector2, ...], ...]. Width in meters.
var paths: Array = []
var path_width := 2.4
## Circles of pavement: [[center Vector2, radius], ...] and rectangles [[Rect2], ...].
var pave_circles: Array = []
var pave_rects: Array = []
## Rectangles and circles where no vegetation grows: [Rect2] and [[center, radius]].
var no_plants_rects: Array = []
var no_plants_circles: Array = []
## Footprints for the minimap and to keep the plants away: [[Rect2, Color]].
var footprints: Array = []
## Houses: [[center Vector2, size Vector2 (x, z), height, yaw in degrees (0/90/180/270), wall Color, roof Color]].
var houses: Array = []


func _init(island: String) -> void:
	id = island
	noise.seed = 11 if island == "villa_syrup" else 23
	noise.frequency = 0.012
	noise.fractal_octaves = 4
	noise2.seed = 5 if island == "villa_syrup" else 9
	noise2.frequency = 0.05
	heights.resize(N * N)


# ------------------------------------------------------------------ height map
func build() -> void:
	if id == "villa_syrup":
		_build_syrup()
	else:
		_build_whisky()
	_register_houses()


func _smooth(a: float, b: float, x: float) -> float:
	var t := clampf((x - a) / (b - a), 0.0, 1.0)
	return t * t * (3.0 - 2.0 * t)


func _coast(p: Vector2, center: Vector2, rx: float, rz: float) -> float:
	var q := Vector2((p.x - center.x) / rx, (p.y - center.y) / rz)
	var ang := atan2(q.y, q.x)
	var d := q.length() * (1.0 + 0.09 * sin(3.0 * ang + 0.7) + 0.06 * sin(5.0 * ang + 2.1) + 0.05 * noise2.get_noise_2d(p.x * 0.4, p.y * 0.4))
	return 1.0 - d


func _bump(p: Vector2, c: Vector2, r: float, height: float) -> float:
	var d2 := p.distance_squared_to(c) / (r * r)
	if d2 >= 1.0:
		return 0.0
	return height * (1.0 - d2) * (1.0 - d2)


## Pulls the terrain to `level` inside r_in and blends back to what it was at r_out.
func _flat_circle(h: float, p: Vector2, c: Vector2, r_in: float, r_out: float, level: float) -> float:
	return lerpf(level, h, _smooth(r_in, r_out, p.distance_to(c)))


func _flat_rect(h: float, p: Vector2, center: Vector2, half: Vector2, blend: float, level: float) -> float:
	var d := Vector2(maxf(absf(p.x - center.x) - half.x, 0.0), maxf(absf(p.y - center.y) - half.y, 0.0)).length()
	return lerpf(level, h, _smooth(0.0, blend, d))


func _base(p: Vector2, center: Vector2, rx: float, rz: float, rolling: float) -> float:
	var m := _coast(p, center, rx, rz)
	var h := lerpf(-5.0, 2.2, _smooth(-0.10, 0.12, m))
	h += (noise.get_noise_2d(p.x, p.y) * 0.5 + 0.5) * rolling * _smooth(0.1, 0.5, m)
	return h


func _fill(f: Callable) -> void:
	for j in N:
		for i in N:
			heights[j * N + i] = f.call(Vector2(i * STEP, j * STEP))
	# the edge of the map is deep sea
	for k in N:
		for e in [0, 1, N - 2, N - 1]:
			heights[k * N + e] = minf(heights[k * N + e], -5.0)
			heights[e * N + k] = minf(heights[e * N + k], -5.0)


# ---- Villa Syrup
const SYRUP_MANSION := Vector2(250, 95)
const SYRUP_MANSION_LEVEL := 11.0
const SYRUP_VILLAGE := Vector2(200, 278)
const SYRUP_HILL := Vector2(95, 225)
const SYRUP_HILL_LEVEL := 13.0
const SYRUP_GRAVE := Vector2(330, 200)
const SYRUP_GRAVE_LEVEL := 4.5


func _build_syrup() -> void:
	var c := Vector2(200, 190)
	_fill(func(p: Vector2) -> float:
		var h := _base(p, c, 165.0, 155.0, 6.0)
		h += _bump(p, SYRUP_HILL, 46.0, 10.0)
		h = _flat_circle(h, p, SYRUP_HILL, 6.0, 26.0, SYRUP_HILL_LEVEL)
		h = _flat_rect(h, p, SYRUP_MANSION, Vector2(44, 38), 40.0, SYRUP_MANSION_LEVEL)
		h = _flat_circle(h, p, SYRUP_VILLAGE, 38.0, 68.0, 2.8)
		h = _flat_circle(h, p, SYRUP_GRAVE, 26.0, 50.0, SYRUP_GRAVE_LEVEL)
		h = _flat_circle(h, p, Vector2(DOCK_X, 328), 14.0, 36.0, 1.7)
		return h)
	paths = [
		[Vector2(200, 334), Vector2(200, 300), Vector2(200, 278)],
		[Vector2(200, 278), Vector2(165, 262), Vector2(130, 245), Vector2(95, 225)],
		[Vector2(200, 278), Vector2(212, 235), Vector2(232, 190), Vector2(244, 150), Vector2(250, 128)],
		[Vector2(200, 278), Vector2(255, 252), Vector2(305, 222), Vector2(318, 205)],
	]
	var wall := Color(0.86, 0.8, 0.68)
	var wood := Color(0.72, 0.66, 0.55)
	var red := Color(0.62, 0.22, 0.16)
	var brown := Color(0.36, 0.25, 0.17)
	houses = [
		[Vector2(172, 260), Vector2(9, 7), 4.0, 0, wall, red], [Vector2(228, 260), Vector2(9, 7), 4.0, 0, wood, brown],
		[Vector2(166, 292), Vector2(8, 8), 4.2, 90, wood, red], [Vector2(234, 293), Vector2(8, 8), 4.2, 270, wall, brown],
		[Vector2(176, 314), Vector2(8, 6), 3.6, 0, wall, brown], [Vector2(228, 316), Vector2(8, 6), 3.6, 0, wood, red],
		[Vector2(146, 275), Vector2(7, 6), 3.6, 90, wood, brown], [Vector2(256, 272), Vector2(7, 6), 3.6, 270, wall, red],
	]
	pave_circles = [[SYRUP_VILLAGE, 11.0]]
	footprints.append([Rect2(SYRUP_MANSION - Vector2(38, 30), Vector2(76, 60)), Color(0.25, 0.22, 0.2)])
	footprints.append([Rect2(SYRUP_GRAVE + Vector2(-25, -20), Vector2(50, 40)), Color(0.3, 0.3, 0.3, 0.6)])
	no_plants_circles = [[SYRUP_VILLAGE, 46.0], [SYRUP_GRAVE, 34.0], [SYRUP_HILL, 12.0], [Vector2(DOCK_X, 330), 24.0]]
	no_plants_rects = [Rect2(SYRUP_MANSION - Vector2(48, 42), Vector2(96, 84))]


# ---- Whisky Peak
const WHISKY_PLAZA := Vector2(200, 250)
const WHISKY_PLATEAU := Vector2(200, 92)
const WHISKY_PLATEAU_LEVEL := 18.0
const WHISKY_ARCH := Vector2(200, 300)


func _build_whisky() -> void:
	var c := Vector2(200, 190)
	_fill(func(p: Vector2) -> float:
		var h := _base(p, c, 160.0, 158.0, 5.0)
		# dunes and low mesas around the town
		h += (noise2.get_noise_2d(p.x, p.y) * 0.5 + 0.5) * 2.0 * _smooth(0.15, 0.4, _coast(p, c, 160.0, 158.0))
		h = _flat_circle(h, p, WHISKY_PLATEAU, 30.0, 84.0, WHISKY_PLATEAU_LEVEL)
		h = _flat_circle(h, p, WHISKY_PLAZA, 44.0, 74.0, 3.0)
		h = _flat_circle(h, p, Vector2(DOCK_X, 328), 14.0, 36.0, 1.7)
		return h)
	paths = [
		[Vector2(200, 334), Vector2(200, 300), Vector2(200, 262)],
		[Vector2(200, 238), Vector2(200, 190), Vector2(196, 150), Vector2(200, 118)],
		[Vector2(186, 250), Vector2(140, 236), Vector2(96, 214)],
		[Vector2(214, 250), Vector2(262, 236), Vector2(300, 212)],
	]
	var adobe := Color(0.86, 0.68, 0.46)
	var clay := Color(0.78, 0.55, 0.36)
	var roof := Color(0.7, 0.4, 0.26)
	var teal := Color(0.3, 0.55, 0.55)
	houses = [
		[Vector2(168, 264), Vector2(10, 9), 4.5, 0, adobe, roof], [Vector2(232, 264), Vector2(10, 9), 4.5, 0, clay, teal],
		[Vector2(166, 290), Vector2(9, 8), 4.2, 90, clay, roof], [Vector2(234, 290), Vector2(9, 8), 4.2, 270, adobe, teal],
		[Vector2(166, 232), Vector2(10, 8), 4.8, 90, adobe, roof], [Vector2(234, 230), Vector2(9, 9), 5.6, 270, clay, roof],
		[Vector2(150, 205), Vector2(8, 8), 4.2, 0, adobe, teal], [Vector2(252, 206), Vector2(8, 8), 4.2, 0, clay, roof],
	]
	pave_circles = [[WHISKY_PLAZA, 15.0]]
	pave_rects = [Rect2(Vector2(194, 262), Vector2(12, 74))]
	no_plants_circles = [[WHISKY_PLAZA, 52.0], [WHISKY_PLATEAU, 36.0], [Vector2(DOCK_X, 330), 24.0]]
	no_plants_rects = []


# ------------------------------------------------------------------ queries
func _register_houses() -> void:
	for h in houses:
		var size: Vector2 = h[1]
		if int(h[3]) % 180 != 0:
			size = Vector2(size.y, size.x)
		footprints.append([Rect2(h[0] - size / 2.0, size), (h[4] as Color).darkened(0.35)])


func ground(x: float, z: float) -> float:
	var fx := clampf(x / STEP, 0.0, N - 1.001)
	var fz := clampf(z / STEP, 0.0, N - 1.001)
	var ix := int(fx)
	var iz := int(fz)
	var tx := fx - ix
	var tz := fz - iz
	var h00 := heights[iz * N + ix]
	var h10 := heights[iz * N + ix + 1]
	var h01 := heights[(iz + 1) * N + ix]
	var h11 := heights[(iz + 1) * N + ix + 1]
	return lerpf(lerpf(h00, h10, tx), lerpf(h01, h11, tx), tz)


func slope(x: float, z: float) -> float:
	var dx := ground(x + 1.5, z) - ground(x - 1.5, z)
	var dz := ground(x, z + 1.5) - ground(x, z - 1.5)
	return sqrt(dx * dx + dz * dz) / 3.0


func distance_to_paths(p: Vector2) -> float:
	var best := INF
	for path in paths:
		for i in range(path.size() - 1):
			var cp := Geometry2D.get_closest_point_to_segment(p, path[i], path[i + 1])
			best = minf(best, p.distance_to(cp))
	return best


func path_mask(p: Vector2) -> float:
	return 1.0 - _smooth(path_width * 0.5, path_width * 0.5 + 1.6, distance_to_paths(p))


func pave_mask(p: Vector2) -> float:
	var m := 0.0
	for pc in pave_circles:
		if p.distance_to(pc[0]) < float(pc[1]):
			m = 1.0
	for r in pave_rects:
		if (r as Rect2).has_point(p):
			m = 1.0
	return m


func plants_allowed(p: Vector2, margin := 0.0) -> bool:
	for r in no_plants_rects:
		if (r as Rect2).grow(margin).has_point(p):
			return false
	for cr in no_plants_circles:
		if p.distance_to(cr[0]) < float(cr[1]) + margin:
			return false
	for fp in footprints:
		if (fp[0] as Rect2).grow(2.0 + margin).has_point(p):
			return false
	return distance_to_paths(p) > 4.0 + margin

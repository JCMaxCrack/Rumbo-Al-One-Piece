[connection signal="collected" from="Collectibles/Meat5" to="." method="_on_item_collected"]
[connection signal="finished" from="ExploreMusic" to="ExploreMusic" method="play"]
[connection signal="finished" from="ChaseMusic" to="ChaseMusic" method="play"]
[connection signal="timeout" from="DefeatTimer" to="." method="_on_defeat_timer_timeout"]
